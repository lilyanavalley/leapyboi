# cfg.toml.example — copy this file to cfg.toml and fill in your values.
#
# cfg.toml is intentionally gitignored to avoid committing credentials.
# build.rs reads this file and passes the values to the firmware at compile time.

[leapyboi]
# Your 2.4 GHz WiFi network name (SSID).
# Note: ESP32-C6 supports both 2.4 GHz and 5 GHz, but ESP-IDF WiFi drivers
# typically work best / most reliably on 2.4 GHz for embedded use.
wifi_ssid = "YOUR_WIFI_SSID"

# WiFi password.
wifi_pass = "YOUR_WIFI_PASSWORD"

# MQTT broker URL.  For a local HomeAssistant instance this is typically:
#   mqtt://192.168.1.x:1883
# TLS (mqtts://) is supported but requires configuring the broker certificate.
mqtt_url = "mqtt://192.168.1.x:1883"

# Client ID sent to the broker.  Must be unique per device on the same broker.
mqtt_client_id = "leapyboi"

# MQTT username used for broker authentication.
# Leave empty to authenticate by client ID only (if broker policy allows it).
mqtt_username = "YOUR_MQTT_USERNAME"

# MQTT password used for broker authentication.
# Leave empty when broker policy does not require a password.
mqtt_password = "YOUR_MQTT_PASSWORD"

# GPIO number wired to the WS2812B DIN data line.
# XIAO ESP32-C6 default: GPIO2 (D0).
led_data_pin_num = 2

# mmWave UART TX pin number on the ESP32-C6 (ESP TX -> sensor RX).
# Change this if your module is wired to a different GPIO.
mmwave_uart_tx_pin_num = 21

# mmWave UART RX pin number on the ESP32-C6 (ESP RX <- sensor TX).
# This pin must match the sensor's TX output wire.
mmwave_uart_rx_pin_num = 2

# UART peripheral for the mmWave sensor.
# 0 = uart0, 1 = uart1. Default is uart1.
mmwave_uart_port = 1

# ── OTA (over-the-air) updates ────────────────────────────────────────────────

# Direct download URL for the firmware binary published in GitHub Releases.
# Replace YOUR_USERNAME / YOUR_REPO_NAME with your actual GitHub username and
# repository name.  The workflow in .github/workflows/release.yml publishes the
# file as "leapyboi.bin" on every versioned tag (e.g. v1.2.3).
ota_firmware_url = "https://github.com/YOUR_USERNAME/YOUR_REPO_NAME/releases/latest/download/leapyboi.bin"

# URL of the plain-text version file published alongside the firmware.
# The file contains only the version string (e.g. "1.2.3") so the device can
# decide whether a download is necessary without fetching the full binary.
ota_version_url = "https://github.com/YOUR_USERNAME/YOUR_REPO_NAME/releases/latest/download/version.txt"
