# sdkconfig.defaults — ESP-IDF Kconfig overrides for leapyboi
#
# These values are merged with the defaults produced by `idf.py menuconfig`.
# They are the minimum set needed for WiFi + TCP/IP + MQTT.

# ── WiFi ──────────────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# ── TCP/IP ────────────────────────────────────────────────────────────────────
CONFIG_LWIP_MAX_SOCKETS=10

# ── MQTT ──────────────────────────────────────────────────────────────────────
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_TCP=y
# Increase the MQTT task stack so it can handle JSON payloads.
CONFIG_MQTT_TASK_STACK_SIZE=6144

# ── Main task ─────────────────────────────────────────────────────────────────
# Increased from 8192 to accommodate the TLS handshake stack during OTA.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# ── Flash ─────────────────────────────────────────────────────────────────────
# 4 MB is the most common flash size for ESP32-C6 modules.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# esp-idf-sys builds from a generated out/ directory; anchor to PROJECT_DIR.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"

# ── OTA (over-the-air) updates ────────────────────────────────────────────────
# Use the built-in two-OTA partition table: nvs + otadata + ota_0 + ota_1.
# Each OTA slot is ~1.5 MB, which is enough for this firmware.
# NOTE: switching from the default single-app layout requires a one-time full
# reflash via USB; subsequent updates can be performed over-the-air.
CONFIG_PARTITION_TABLE_TWO_OTA=n

# ── HTTPS / TLS ───────────────────────────────────────────────────────────────
# Embed the full Mozilla CA certificate bundle so the device can verify
# GitHub's TLS certificate when downloading firmware updates.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Enable HTTPS support in the ESP-IDF HTTP client used by the OTA module.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
